# LLM connection used by the FastAPI bot backend (/get_message).
# These defaults match the `llm` service in docker-compose.yaml.
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-0.5b-instruct
LLM_API_KEY=not-needed
LLM_MAX_TOKENS=128
LLM_TEMPERATURE=0.8

# Where the Streamlit UI finds the bot backend (compose service name).
ECHO_BOT_URL=http://fastapi:6872
