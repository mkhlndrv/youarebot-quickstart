# Example configuration. The stack runs with the defaults baked into
# docker-compose.yaml, so you do NOT need a real .env to start it. Copy this to
# .env only if you want to override something. No secrets are required.

# --- public gateway ---
# Internal addresses use compose service names, never localhost.
CLASSIFIER_URL=http://classifier:8000
LLM_URL=http://llm:11434
LLM_MODEL=qwen2.5-0.5b-instruct
CLASSIFIER_TIMEOUT=30
LLM_TIMEOUT=120

# --- classifier / MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
REGISTERED_MODEL_NAME=youarebot-classifier

# llama.cpp ignores the API key; it is only here because OpenAI clients expect
# one. This is NOT a secret.
LLM_API_KEY=not-needed
